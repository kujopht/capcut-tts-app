      "Read(**/.credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.netrc)",
