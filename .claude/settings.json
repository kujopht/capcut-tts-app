{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",

    "deny": [
      "Bash(git push *force*)",
      "Bash(git push *-f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push*force*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.netrc)",
      "Read(**/gh/hosts.yml)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Read(**/Login Data)",
      "Read(**/Login Data For Account)",
      "Read(**/Cookies)",

      "Bash(cat *.env*)",
      "Bash(cat *credentials*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem)",
      "Bash(cat *.git-credentials*)",
      "Bash(cat *hosts.yml*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *credentials*)",
      "Bash(*Login Data*)",
      "Bash(security find-generic-password*)",
      "Bash(gh auth token*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh api *DELETE*)",

      "Bash(wrangler r2 bucket delete*)",
      "Bash(wrangler kv:namespace delete*)",
      "Bash(wrangler kv namespace delete*)",
      "Bash(wrangler d1 delete*)",
      "Bash(wrangler delete*)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item * -Recurse -Force*)"
    ],

    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr create*)",
      "Bash(gh workflow run*)",
      "Bash(gh api*)",
      "Bash(gh release*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler rollback*)",
      "Bash(npm run cf:deploy*)",
      "Bash(curl *RENDER_DEPLOY_HOOK*)",
      "Bash(curl * onrender.com*)",

      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(deploy/render*.yaml)",
      "Write(deploy/render*.yaml)"
    ]
  }
}
