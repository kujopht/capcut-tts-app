      "Bash(cat *.env*)",
      "Bash(cat *credentials*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem)",
      "Bash(cat *.git-credentials*)",
      "Bash(cat *hosts.yml*)",
      "Bash(cat *rclone.conf*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *credentials*)",
      "Bash(*Login Data*)",
      "Bash(security find-generic-password*)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
