# --- Backend web (FastAPI) ---
server/__pycache__/
server/.pytest_cache/
server/var/
# Moi thu muc runtime cua worker, ke ca ban rieng cua tung moi truong.
# `FAS_VAR_DIR` cua production tro vao `server/var-production/` — trong do co
# tep nhip va tep audio tam. Khong bao gio commit du lieu runtime.
server/var-*/
server/.venv/

# --- Bien moi truong: chan het TRU file mau ---
.env
.env.*
!.env.example
!web/.env.example
!server/.env.example

# --- Cloudflare Workers / OpenNext (sinh ra luc build, khong commit) ---
web/.open-next/
web/.wrangler/
web/cloudflare-env.d.ts
# Bien moi truong cuc bo cua wrangler — CO THE CHUA SECRET.
.dev.vars
.dev.vars.*

# Thu muc runtime rieng cua tung moi truong worker (FAS_VAR_DIR).
# Dat o day thay vi canh `server/var/` de khong dam vao cung mot vung voi
# PR #4 — hai lan them cung mot quy tac o hai cho khac nhau thi merge sach.
server/var-*/

# --- Artefact benchmark / validate model (khong bao gio commit) ---
bench_piper_*/
benchmark-*.csv
benchmark-*.json
models-report-*.json

# Tranh nen goc dang PNG (~21 MB). Ban WebP canh chung MOI la thu duoc phuc vu;
# CSS khong bao gio tro toi `.png`. Giu tep goc tren dia de con nguon, nhung
# khong bat kho git ganh 21 MB cho thu khong ai tai ve.
web/public/artwork/fantasy-backgrounds/*.png

# Bo anh nen CYBERPUNK cua ban truoc — da bi thay bang bo fantasy o
# `fantasy-backgrounds/`. Giu lai tren dia de doi chieu, khong dua vao kho.
web/public/artwork/backgrounds/

# Bao cao/ghi chep dung mot lan cua phien lam viec — khong thuoc san pham.
scratchpad/
