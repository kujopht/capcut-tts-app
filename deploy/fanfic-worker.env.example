# MẪU cho /etc/fanfic-audio/worker.env — KHÔNG CÓ GIÁ TRỊ THẬT NÀO Ở ĐÂY.
#
# Chép sang VM rồi điền tay:
#
#   sudo install -d -m 0750 -o root -g fanfic /etc/fanfic-audio
#   sudo install -m 0600 -o root -g fanfic /dev/null /etc/fanfic-audio/worker.env
#   sudo -e /etc/fanfic-audio/worker.env          # dán giá trị vào đây
#
# Quyền 0600 và chủ sở hữu root là có chủ ý: tiến trình worker đọc được qua
# `EnvironmentFile=` (systemd đọc bằng quyền root TRƯỚC khi hạ quyền), còn người
# dùng `fanfic` thì không đọc được. Một tiến trình worker bị chiếm cũng không
# đọc lại được tệp secret của chính nó.
#
# TUYỆT ĐỐI KHÔNG:
#   * commit tệp đã điền vào git — `.gitignore` chặn `.env.*` nhưng tên tệp này
#     không khớp mẫu đó, nên đừng đặt nó trong repo;
#   * `echo` hay `cat` nó trong phiên SSH có ghi log;
#   * đưa giá trị vào `systemctl edit` / `Environment=` — `systemctl show` in ra hết.

# -- môi trường ---------------------------------------------------------------
# BẮT BUỘC là `staging`. Unit chạy với `--require-env staging`, giá trị khác sẽ
# làm worker thoát ngay với mã 2.
FAS_ENV=staging

# Worker là tiến trình riêng; web không được tự chạy job. Xem deploy/RUNBOOK.md.
FAS_INLINE_WORKER=false

DATA_BACKEND=appwrite
STORAGE_BACKEND=r2

# -- Appwrite -----------------------------------------------------------------
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=

# -- Cloudflare R2 ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -- điều chỉnh worker (tuỳ chọn) ---------------------------------------------
# Bỏ trống là dùng mặc định. Chỉ đụng vào khi có lý do đo được.
#
# FAS_WORKER_POLL_SECONDS=3       # chu kỳ quét job mới
# FAS_WORKER_GRACE_SECONDS=120    # chờ job đang chạy khi dừng.
#                                 # Tăng thì PHẢI tăng TimeoutStopSec trong unit.
# FAS_JOB_LEASE_SECONDS=90        # lease sống bao lâu nếu không được gia hạn
# FAS_JOB_HEARTBEAT_SECONDS=30    # chu kỳ gia hạn lease
#
# RÀNG BUỘC: lease phải dài ít nhất GẤP BA chu kỳ nhịp. `server/main.py` kiểm
# tra lúc khởi động và dừng hẳn nếu sai — lease ngắn hơn thế thì nó sẽ hết hạn
# giữa hai lần đập, và một job đang chạy bình thường sẽ bị bộ quét nhận lại.
#
# Độ dài CHƯƠNG không liên quan gì tới hai số này: nhịp còn đập thì lease còn
# sống, chương ba tiếng đồng hồ cũng vậy.
