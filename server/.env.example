# ============================================================
#  Fanfic Audio Studio - backend web
#  Sao chep thanh server/.env roi dien gia tri that.
#  server/.env DA bi .gitignore chan - TUYET DOI khong commit secret.
#
#  MOI BIEN O FILE NAY LA SERVER-ONLY. Trinh duyet khong bao gio thay chung.
#  Bien cong khai duy nhat cua frontend nam o web/.env.example
#
#  FILE NAY DUOC NAP NHU THE NAO
#  -----------------------------
#  `server/config.py` nap file nay bang duong dan tinh theo VI TRI MODULE,
#  nen chay tu repo root hay tu bat cu thu muc nao cung nap dung mot file.
#  Khong can co `--env-file` cho uvicorn.
#
#  THU TU UU TIEN: bien da co trong moi truong tien trinh LUON THANG file nay.
#      shell / CI / production  >  server/.env
#  Nho vay bien that duoc tiem vao luc trien khai khong bi file cu ghi de.
#
#  Khong co file nay cung khong sao: backend chay che do mock/local.
#  Kiem tra file da co tac dung chua: GET /api/health -> "env_file_loaded": true
#
#  `FAS_ENV_FILE` co the tro sang file khac; dat chuoi rong = khong nap file nao.
# ============================================================

# development | production
FAS_ENV=development

# Origin duoc phep goi API, cach nhau bang dau phay.
# O production KHONG duoc dung "*" vi backend gui kem credentials.
FAS_CORS_ORIGINS=http://localhost:3000

# Thu muc du lieu runtime (audio tam, kho file cuc bo). De trong = server/var
# FAS_VAR_DIR=

# Giong Piper chay cuc bo CHUA xac minh giay phep.
# Mac dinh chi bat o development. KHONG bat o production khi chua xac minh.
# FAS_ALLOW_UNVERIFIED_LOCAL_VOICES=0

# ------------------------------------------------------------
#  Tach worker TTS - QUAN TRONG o staging/production
# ------------------------------------------------------------
# true  (mac dinh) = tien trinh web tu chay job TTS trong thread nen.
#                    Tien cho may lap trinh vien, MOT tien trinh lam ca hai viec.
# false            = web CHI phuc vu request. Job nam `pending` cho tien trinh
#                    `python -m server.worker` nhan.
#
# O staging/production PHAI dat `false`, va PHAI chay it nhat mot worker:
#   - restart web khong duoc giet job dang chay giua chung;
#   - mot chuong dai khong duoc giu thread hang chuc phut trong tien trinh phuc
#     vu request;
#   - web va worker phai scale doc lap.
#
# CANH BAO: dat `false` ma khong chay worker nao thi job nam `pending` MAI.
# Kiem tra: GET /api/health -> "inline_worker": false, va worker phai co nhip.
# Gia tri khong hieu duoc se lam backend DUNG NGAY, khong am tham lay mac dinh.
# FAS_INLINE_WORKER=false

# ------------------------------------------------------------
#  Chon backend - TUONG MINH, khong tu doan
# ------------------------------------------------------------
# mock    = danh tinh + metadata trong bo nho (mac dinh, cho phat trien)
# appwrite = dung Appwrite that; thieu/sai cau hinh se DUNG NGAY, khong lui ve mock
DATA_BACKEND=mock

# local = luu file xuong dia (mac dinh, cho phat trien)
# r2    = Cloudflare R2; thieu/sai cau hinh se DUNG NGAY, khong lui ve local
STORAGE_BACKEND=local

# ------------------------------------------------------------
#  Appwrite - SERVER-ONLY (chi can khi DATA_BACKEND=appwrite)
# ------------------------------------------------------------
# Phai dien DU ca 4 dong. Endpoint va project id co the lo ra client,
# nhung API KEY thi TUYET DOI khong.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# ------------------------------------------------------------
#  Cloudflare R2 - SERVER-ONLY (chi can khi STORAGE_BACKEND=r2)
# ------------------------------------------------------------
# Bucket phai la PRIVATE. Backend cap URL ky han ngan sau khi kiem tra quyen.
# Phai dien DU ca 4 dong.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ------------------------------------------------------------
#  Chi cua TIEN TRINH WORKER (server/worker.py)
# ------------------------------------------------------------
# Web khong doc cac bien nay. Worker doc CUNG bo Appwrite/R2 o tren, cong them:

# Chu ky quet job, giay. Ngan hon `JOB_SWEEP_SECONDS` cua web vi day la viec
# duy nhat cua tien trinh worker.
# FAS_WORKER_POLL_SECONDS=3

# Khi nhan tin hieu dung: cho job dang chay bao nhieu giay truoc khi thoat.
# Dai hon thoi gian tong hop mot chuong dai thi khong bao gio bo job giua chung.
# FAS_WORKER_GRACE_SECONDS=120

# `python -m server.worker --check` coi nhip cu hon nguong nay la worker treo.
# Mac dinh = FAS_WORKER_POLL_SECONDS * 10 + 30.
# FAS_WORKER_STALE_SECONDS=60

# ============================================================
#  PHAN LOAI BIEN - ai duoc thay cai gi
# ============================================================
#
#  CONG KHAI (nam trong bundle trinh duyet, ai cung doc duoc)
#    NEXT_PUBLIC_API_BASE            -> chi o web/.env.local
#
#  SECRET, CHI BACKEND (web/API)
#    APPWRITE_API_KEY
#    R2_ACCESS_KEY_ID
#    R2_SECRET_ACCESS_KEY
#
#  SECRET, CHI WORKER
#    Cung ba bien tren. Worker doc va ghi CUNG kho, nen can cung quyen.
#    Neu nen tang cho phep, hay cap HAI credential khac nhau cho web va worker
#    de thu hoi rieng duoc tung ben khi lo.
#
#  DINH DANH - khong phai secret, nhung khong nen cong khai
#    APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID, APPWRITE_DATABASE_ID
#    R2_ACCOUNT_ID, R2_BUCKET
#
#  TUYET DOI KHONG dat bat ky bien nao o tren vao web/.env.local: moi bien
#  NEXT_PUBLIC_* deu di thang vao bundle va ai cung doc duoc.

# Khoa RIENG cho viec quan schema (scripts/setup_appwrite.py). TUY CHON.
# Scopes can: databases.read, collections.read/write, attributes.read/write,
# indexes.read/write. KHONG dat len Render — khoa runtime chi can documents.
# APPWRITE_SCHEMA_API_KEY=

# ------------------------------------------------------------
#  Novel Translation Studio (V5) — provider dich that. TUY CHON.
# ------------------------------------------------------------
# Ca ba bien deu rong thi `TranslationService` dung MockTranslationProvider
# (khong goi mang, dich gia) — moi truong dev/test khong can dien gi o day.
# Dien du CA BA thi chuyen sang goi that mot endpoint tuong thich OpenAI
# chat completions (KHONG phai goi thu vien PyPI `docutranslate` — xem ghi
# chu kien truc trong server/translation_providers.py::DocuTranslateProvider).
#
# TRANSLATION_BASE_URL: goc URL cua nha cung cap, VI DU https://api.openai.com/v1
# TRANSLATION_API_KEY : SECRET — key cua nha cung cap do.
# TRANSLATION_MODEL   : ten model, VI DU gpt-4o-mini, deepseek-chat...
# TRANSLATION_BASE_URL=
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=
#
# "Tuy chinh" o tren CHI duoc coi la mien phi (dua vao ho boi Fanfic Free)
# neu dat ro rang bang co nay — mac dinh AN de tranh vo tinh coi mot endpoint
# tra phi la "mien phi tu dong thu" (xem TRANSLATION_ALLOW_PAID_PROVIDER).
# TRANSLATION_CUSTOM_PROVIDER_FREE=false

# ------------------------------------------------------------
#  Da provider mien phi cho kho Fanfic Free dung chung (Part Q, V5) — TUY CHON.
# ------------------------------------------------------------
# Moi provider bat qua BIEN RIENG cua no (khong dung chung mot blob JSON) —
# mot bi mat co the thu hoi doc lap voi cac bi mat khac. Thieu bien cua MOT
# provider chi lam provider DO khong xuat hien trong catalog, khong lam
# hong ca he thong (Mock/cac provider khac van chay binh thuong).
#
# Groq (mien phi) — overnight Phase 3 (V5.2, Part R): MOT GROQ_API_KEY duy
# nhat gio tu dong dua VAO CA BA model curated (Qwen 3.6 27B, GPT-OSS 120B,
# GPT-OSS 20B) — moi model la MOT muc catalog rieng, dinh tuyen theo vai
# tro/che do chat luong (xem server/translation_model_profiles.py). KHONG
# can dat GROQ_MODEL nua cho truong hop thong thuong.
# GROQ_API_KEY=
#
# GROQ_MODEL van con tuong thich nguoc — CHI can dat neu ban muon THEM mot
# model Groq KHAC ba model curated o tren (vi du mot model moi Groq ra mat
# sau nay ma code chua kip biet). Dat trung mot trong ba model curated se bi
# bo qua (khong tao muc trung lap).
# GROQ_MODEL=qwen/qwen3.6-27b
#
# Cloudflare Workers AI (mien phi):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_WORKERS_AI_MODEL=
#
# Pollinations.ai (TRA PHI THEO MAC DINH — doc ky truoc khi bat):
# POLLINATIONS_API_KEY : SECRET — key dang sk_... cua Pollinations.
# POLLINATIONS_FREE_TIER: BAT BUOC dat "true" neu muon THUC SU dung provider
#   nay. Chi co API key la KHONG DU: Pollinations khong the phan loai
#   mien-phi/tra-phi tu ben ngoai mot cach dang tin cay, nen he thong coi no
#   la TRA PHI va bo qua im lang. Dat "true" la ban TUYEN BO tai khoan cua
#   ban o hang mien phi va chiu trach nhiem ve chi phi.
#   LUU Y: TRANSLATION_ALLOW_PAID_PROVIDER=true MOT MINH KHONG mo duoc
#   provider nay — ProviderRegistry con loc free_tier vo dieu kien. Xem
#   test_rao_chan_chung_MOT_MINH_van_KHONG_du.
# POLLINATIONS_BASE_URL: tuy chon, ghi de endpoint (mac dinh
#   https://gen.pollinations.ai/v1).
# POLLINATIONS_RETRY_COUNT: tuy chon, so lan THU LAI CUC BO khi bi 429
#   (mac dinh 0 = tat). Chi ap dung cho 429; loi credential/hinh dang KHONG
#   duoc thu lai. Het luot thi chuyen sang nha cung cap DOC LAP tiep theo.
# POLLINATIONS_API_KEY=
# POLLINATIONS_FREE_TIER=false
# POLLINATIONS_BASE_URL=
# POLLINATIONS_RETRY_COUNT=0
#
# HANG RAO BAO VE: khi false (mac dinh), KHONG provider nao duoc danh dau
# tra phi duoc dua vao duong thu tu dong — kho Fanfic Free CHI dung provider
# mien phi. Chi doi thanh true khi CO CHU DICH muon them mot provider tra
# phi vao AUTO/fallback.
# LUU Y (do duoc khi viet test, khong phai suy dien): bien nay MOT MINH
# khong du de dung mot provider tra phi — `ProviderRegistry.__init__` con
# loc `free_tier` VO DIEU KIEN ("an toan kep"). Muon dung provider tra phi
# thi phai danh dau RIENG provider do la mien phi (vi du
# POLLINATIONS_FREE_TIER / TRANSLATION_CUSTOM_PROVIDER_FREE).
# TRANSLATION_ALLOW_PAID_PROVIDER=false

# ------------------------------------------------------------
#  BYOK — nguoi dung ket noi API key AI CA NHAN cua ho (V5.1) — TUY CHON.
# ------------------------------------------------------------
# Khi han muc Fanfic Free dung chung het, nguoi dung co the ket noi API key
# Groq CUA RIENG HO va tiep tuc dich bang han muc cua chinh ho — Fanfic
# KHONG BAO GIO dung key cua nguoi nay cho nguoi khac, va key CHI duoc luu
# o dang DA MA HOA (AES-256-GCM), khong bao gio o dang van ban ro.
#
# TRANSLATION_BYOK_MASTER_KEY: base64 cua DUNG 32 byte (AES-256) — BAT BUOC
# CHI-BACKEND/worker, KHONG BAO GIO la NEXT_PUBLIC_*, KHONG BAO GIO commit
# gia tri that (dong duoi day CHI la vi tri de dien, khong phai key that).
# Vang mat = tinh nang BYOK KHONG hoat dong (cac route ket noi ca nhan tra
# 503 ro rang) — moi truong dev/test khong can dien gi o day.
#
# SINH MOI: chi chay MOT LAN luc thiet lap — moi lan chay la MOT khoa MOI,
# se KHONG giai ma duoc du lieu BYOK da ma hoa bang khoa cu (xoay khoa that
# — doi khoa ma van giu duoc du lieu cu — CHUA trien khai, dinh dang chuoi
# ma hoa da co san "v1" de lam viec nay sau ma khong can migrate lai):
#
#     .\.venv\Scripts\python.exe -c "from server.translation_byok_crypto import sinh_master_key_moi; print(sinh_master_key_moi())"
#
# TRANSLATION_BYOK_MASTER_KEY=<base64-cua-32-byte-ngau-nhien-KHONG-DUOC-COMMIT>

# ------------------------------------------------------------
#  Quan tri — BA MUC (Admin Control Center V2). Xem docs/ADMIN.md.
# ------------------------------------------------------------
# Danh sach user_id, ngan cach bang dau phay. MAC DINH RONG o CA BA — khong ai
# la quan tri. Day la VAR NAME cong khai (da o docs/ADMIN.md tu truoc); GIA
# TRI (user_id that) moi la thu KHONG BAO GIO commit — dong duoi day CHI la
# vi tri de dien.
#
# Mot user_id nam trong NHIEU danh sach cung luc thi muc CAO NHAT thang
# (khong cong don) — xem Settings.admin_role_of.
# FAS_OWNER_USER_IDS=
# FAS_ADMIN_USER_IDS=
# FAS_MODERATOR_USER_IDS=

# ------------------------------------------------------------
#  YouTube Data API — Trusted Video Sources (Phan B, animation-trusted-video-v2)
# ------------------------------------------------------------
# CAN de resolve channel/video/playlist that qua YouTube Data API v3 khi them
# Nguon tin cay. TUY CHON o giai doan hien tai — thieu bien nay thi tinh nang
# Trusted Video Sources bao loi ro rang thay vi gia lap du lieu.
# YOUTUBE_API_KEY=

# Goc URL CONG KHAI qua HTTPS de dang ky WebSub (PubSubHubbub) voi YouTube
# (Phase 6) — vi du "https://api.fanfic.world". RONG trong dev cuc bo:
# YouTube khong goi toi duoc mot backend chi chay o localhost, cac nut
# dang ky/gia han se bao "chua cau hinh" ro rang. CHI dat bien nay khi
# backend that su duoc trien khai cong khai.
# YOUTUBE_WEBSUB_CALLBACK_BASE_URL=

# ------------------------------------------------------------
#  Phan tich luu luong truy cap (Traffic Analytics) — Admin Control Center
#  V2, Phase 7. Xem server/traffic_analytics.py.
# ------------------------------------------------------------
# Cloudflare Web/Zone Analytics qua GraphQL Analytics API — TUY CHON, TACH
# BIET voi CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_API_TOKEN o tren (Workers AI,
# pham vi token khac nhau). Thieu MOT trong hai bien duoi day thi trang
# /admin/analytics hien "Traffic analytics not configured" ro rang, KHONG
# gia lap so lieu. Chua co credential that trong du an nay — CHUA hien thuc
# lan goi GraphQL that (xem docstring `CloudflareTrafficProvider.overview`).
# CLOUDFLARE_ANALYTICS_ZONE_ID=
# CLOUDFLARE_ANALYTICS_API_TOKEN=
