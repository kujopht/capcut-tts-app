# ============================================================
#  Fanfic Audio Studio - backend web
#  Sao chep file nay thanh server/.env roi dien gia tri that.
#  server/.env DA bi .gitignore chan - tuyet doi khong commit secret.
# ============================================================

# development | production
FAS_ENV=development

# Origin cua web, cach nhau bang dau phay
FAS_CORS_ORIGINS=http://localhost:3000

# Thu muc du lieu runtime (audio tam, kho file cuc bo). De trong = server/var
# FAS_VAR_DIR=

# Giong Piper chay cuc bo CHUA xac minh giay phep.
# Mac dinh chi bat o development. KHONG bat o production cho toi khi xac minh.
# FAS_ALLOW_UNVERIFIED_LOCAL_VOICES=0

# --- Appwrite (de trong = dung adapter mock trong bo nho) ---
# Phai dien DU ca 4 dong thi Appwrite moi duoc kich hoat.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# --- Cloudflare R2 (de trong = luu file xuong dia cuc bo) ---
# Phai dien DU ca 4 dong thi R2 moi duoc kich hoat.
# BI MAT CHI O BACKEND - khong bao gio gui xuong trinh duyet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
