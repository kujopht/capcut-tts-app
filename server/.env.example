# ============================================================
#  Fanfic Audio Studio - backend web
#  Sao chep thanh server/.env roi dien gia tri that.
#  server/.env DA bi .gitignore chan - TUYET DOI khong commit secret.
#
#  MOI BIEN O FILE NAY LA SERVER-ONLY. Trinh duyet khong bao gio thay chung.
#  Bien cong khai duy nhat cua frontend nam o web/.env.example
#
#  FILE NAY DUOC NAP NHU THE NAO
#  -----------------------------
#  `server/config.py` nap file nay bang duong dan tinh theo VI TRI MODULE,
#  nen chay tu repo root hay tu bat cu thu muc nao cung nap dung mot file.
#  Khong can co `--env-file` cho uvicorn.
#
#  THU TU UU TIEN: bien da co trong moi truong tien trinh LUON THANG file nay.
#      shell / CI / production  >  server/.env
#  Nho vay bien that duoc tiem vao luc trien khai khong bi file cu ghi de.
#
#  Khong co file nay cung khong sao: backend chay che do mock/local.
#  Kiem tra file da co tac dung chua: GET /api/health -> "env_file_loaded": true
#
#  `FAS_ENV_FILE` co the tro sang file khac; dat chuoi rong = khong nap file nao.
# ============================================================

# development | production
FAS_ENV=development

# Origin duoc phep goi API, cach nhau bang dau phay.
# O production KHONG duoc dung "*" vi backend gui kem credentials.
FAS_CORS_ORIGINS=http://localhost:3000

# Thu muc du lieu runtime (audio tam, kho file cuc bo). De trong = server/var
# FAS_VAR_DIR=

# Giong Piper chay cuc bo CHUA xac minh giay phep.
# Mac dinh chi bat o development. KHONG bat o production khi chua xac minh.
# FAS_ALLOW_UNVERIFIED_LOCAL_VOICES=0

# ------------------------------------------------------------
#  Chon backend - TUONG MINH, khong tu doan
# ------------------------------------------------------------
# mock    = danh tinh + metadata trong bo nho (mac dinh, cho phat trien)
# appwrite = dung Appwrite that; thieu/sai cau hinh se DUNG NGAY, khong lui ve mock
DATA_BACKEND=mock

# local = luu file xuong dia (mac dinh, cho phat trien)
# r2    = Cloudflare R2; thieu/sai cau hinh se DUNG NGAY, khong lui ve local
STORAGE_BACKEND=local

# ------------------------------------------------------------
#  Appwrite - SERVER-ONLY (chi can khi DATA_BACKEND=appwrite)
# ------------------------------------------------------------
# Phai dien DU ca 4 dong. Endpoint va project id co the lo ra client,
# nhung API KEY thi TUYET DOI khong.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# ------------------------------------------------------------
#  Cloudflare R2 - SERVER-ONLY (chi can khi STORAGE_BACKEND=r2)
# ------------------------------------------------------------
# Bucket phai la PRIVATE. Backend cap URL ky han ngan sau khi kiem tra quyen.
# Phai dien DU ca 4 dong.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
