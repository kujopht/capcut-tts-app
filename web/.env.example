# ============================================================
#  Fanfic Audio Studio - frontend
#  Sao chep thanh web/.env.local roi chinh neu can.
#
#  CHI dat bien CONG KHAI o day. Moi bien co tien to NEXT_PUBLIC_ deu duoc
#  nhung thang vao bundle va AI CUNG DOC DUOC.
#
#  TUYET DOI khong dat APPWRITE_API_KEY, R2_ACCESS_KEY_ID hay
#  R2_SECRET_ACCESS_KEY o day - chung chi thuoc ve server/.env
# ============================================================

# URL cua backend FastAPI
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Sentry web (project `fanfic-web`) — TUY CHON, de trong = TAT (khong nghe loi, khong tai SDK).
# DSN la toa do CONG KHAI cua Sentry (thiet ke de nam trong trinh duyet), KHONG phai token.
# NEXT_PUBLIC_SENTRY_ENV: development | staging | production — khong dat = development
# (chi workflow deploy production dat `production`).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENV=development
