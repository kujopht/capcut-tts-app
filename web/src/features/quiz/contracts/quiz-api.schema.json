    "EntitlementSummary": {
      "additionalProperties": false,
      "description": "Chi de HIEN THI. Quyet dinh nam o server (`server/quiz/entitlements.py`).",
      "properties": {
        "plan": {
          "enum": [
            "free",
            "pro"
          ],
          "title": "Plan",
          "type": "string"
        },
        "pro_expires_at": {
