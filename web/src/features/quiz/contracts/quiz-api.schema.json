        "max_score": {
          "maximum": 200,
          "minimum": 1,
          "title": "Max Score",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/ModeRef"
        },
        "phase": {
          "enum": [
            "answering",
            "revealed",
            "finished"
